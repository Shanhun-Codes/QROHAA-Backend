{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolvePackageJsonExports": false,
    "rootDir": ".",
    "outDir": "./dist-bootstrap",
    "declaration": false,
    "incremental": false
  },
  "include": [
    "scripts/bootstrap-platform-admins.ts",
    "scripts/setup-test-agency.ts",
    "scripts/verify-agency-seats.ts",
    "src/**/*.ts",
    "generated/prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-bootstrap",
    "test",
    "**/*.spec.ts"
  ]
}
